# Credenciales para la red local de ISBE.
# Copiar a .env: cp .env_sample .env
#
# Los valores de abajo son la cuenta #0 del mnemonic publico estandar de Hardhat
# ("test test test test test test test test test test test junk"). En la red local
# esa cuenta tiene rol de administracion sobre el Diamond de gobernanza en el genesis:
# es la que puede ejecutar los 3 pasos de despliegue.
#
# AVISO: son credenciales publicas, validas solo para desarrollo local.
# Nunca usarlas en un entorno con valor real.

ACCOUNT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ACCOUNT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC de la red local levantada desde el clon de isbe-clients-template.
LOCALHOST_URL=http://localhost:8545

# Opcionales. Si se fijan las dos, deployNotariza.ts concede PAUSER_ROLE y
# _NOTARIZA_ADMIN_ROLE a estas dos direcciones en lugar de a la cuenta que firma.
# Sirven para ensayar en local la estructura real de dos administradores.
# ADMIN_1=
# ADMIN_2=